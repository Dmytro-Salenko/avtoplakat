# Email одержувача замовлень (менеджер або адміністратор)
# Встановлюється як секрет у Cloudflare Dashboard (не потрапляє в код)
OWNER_EMAIL=order@guajiro.com.ua

# Email відправника через SendGrid (має бути верифікований у SendGrid)
SENDER_EMAIL=

# API-ключ SendGrid для надсилання листів
SENDGRID_API_KEY=
